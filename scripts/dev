#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NODE_BIN=${EMPIRE_NODE_BIN:-"$HOME/.local/bin/node"}

if [ ! -x "$NODE_BIN" ]; then
  NODE_BIN=$(command -v node 2>/dev/null || true)
fi

if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
  echo "未找到可用的 Node.js。请安装 Node 22.22.3，或设置 EMPIRE_NODE_BIN。" >&2
  exit 1
fi

exec "$NODE_BIN" "$ROOT/scripts/dev.mjs" "$@"
