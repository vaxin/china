{
  "name": "empire-web-game",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @empire/game-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint --max-warnings=0 apps packages *.ts",
    "format:check": "prettier --check apps packages package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.tools.json vitest.config.ts playwright.config.ts eslint.config.mjs .github/workflows",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --project=chromium",
    "test:e2e:smoke": "pnpm build && playwright test --project=firefox --project=webkit --grep S-01",
    "test:all": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e && pnpm test:e2e:smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
